{
  "name": "face-value-server",
  "private": true,
  "type": "module",
  "description": "Сервер FACE VALUE: рейтинг + Telegram-бот (/start). Cloudflare Worker + D1",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "esbuild src/index.js --bundle --format=esm --platform=neutral --target=es2022 --charset=utf8 --legal-comments=none --outfile=dist/worker.js",
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute face-value --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute face-value --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.0.0"
  }
}
